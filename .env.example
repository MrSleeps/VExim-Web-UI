APP_NAME="VExim Web"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GB
APP_TIMEZONE="Europe/London"
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=YOUR_LOGIN
DB_USERNAME=YOUR_USERNAME
DB_PASSWORD=YOUR_PASSWORD

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=vw

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_FROM_SUPPORT_ADDRESS="support@example.com"
MAIL_FROM_SUPPORT_NAME="Support"

VITE_APP_NAME="${APP_NAME}"

VEXIM_GID=
VEXIM_UID=
# VEXIM_SYSADMIN_SET_GUID: Either true or false
VEXIM_SYSADMIN_SET_GUID=true
VEXIM_MAIL_ROOT=/var/vmail

# Either rpsamd, spamass or none (if you are a maniac and have no spam filtering)
VEXIM_SPAM_ENGINE=rspamd

# VEXIM_MAILMAN_ENABLED: Either true or false
VEXIM_MAILMAN_ENABLED=false

# VEXIM_ENFORCE_2FA: Either true or false
VEXIM_ENFORCE_2FA=false

# Email address to send health check reports to
HEALTH_TO_ADDRESS=your@email.com

# For the DMARC Plugin (If Used)
DMARC_EMAIL=dmarc@your-domain.com
DMARC_IMAP_HOST=
DMARC_IMAP_PORT=
DMARC_IMAP_ENCRYPTION=
DMARC_IMAP_USERNAME=
DMARC_IMAP_PASSWORD=
DMARC_IMAP_VALIDATE_CERT=
DMARC_IMAP_DEBUG=false



# Enable this and change settings at your own risk! (No support will be given if you do so!)
SHIELD_VISIBLE=false

